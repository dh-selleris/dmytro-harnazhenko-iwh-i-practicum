# Copy this file to .env and fill in both values.
# .env is listed in .gitignore and must never be committed - it holds your private app access token.

# Private app access token from your HubSpot developer test account.
PRIVATE_APP_ACCESS=

# Custom object type id, e.g. 2-12345678. Visible in the custom object list view URL:
# https://app.hubspot.com/contacts/<portal-id>/objects/<custom-object-id>/views/all/list
CUSTOM_OBJECT_TYPE=
